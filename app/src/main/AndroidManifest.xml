<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- صلاحيات المزامنة السحابية فقط: لا صلاحيات تخزين (قاعدة Room داخلية آمنة) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- الإشعارات الفورية مثل واتساب: إشعار عند وصول رسالة أو طلب شراء والتطبيق مغلق -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- تسجيل الرسائل الصوتية في المراسلات (الإصدار 1.8): صلاحية زمنية
         تُطلب عند أول ضغط على زر المايك — ولا تُستخدم إلا للتسجيل داخل التطبيق -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- الفقاعة العائمة مثل ماسنجر: تظهر فوق التطبيقات الأخرى عند وصول رسالة
         (إذن يُمنح يدوياً من زر مخصص في الإعدادات — وبدونه تعمل الفقاعة داخل التطبيق) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".HouseBudgetApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.HouseBudget">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- خدمة المزامنة اللحظية: استقصاء كل 2-5 ثوانٍ + إشعارات المراسلات الواردة -->
        <service
            android:name=".sync.SyncForegroundService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <!-- إعادة تشغيل خدمة الإشعارات تلقائياً بعد إقلاع الهاتف -->
        <receiver
            android:name=".sync.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- خدمة حفظ اللغة العربية المفروضة على التطبيق (Per-app language) -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
